# .env.example
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Telegram Bot Token
# Get from @BotFather on Telegram:
#   1. Open Telegram and search for @BotFather
#   2. Type /newbot
#   3. Follow the steps to create your bot
#   4. Copy the token that looks like: 123456789:ABC-DEF...
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Bot behavior settings
# ─────────────────────────────────────────────────────────────────────────────

# Risk threshold (0.0–1.0). Messages above this are flagged as crisis.
# Lower = more sensitive (more alerts). Higher = more precise (fewer alerts).
CRISIS_THRESHOLD=0.60

# Set to true to log all messages (useful for testing, disable in production)
DEBUG_MODE=false

# Custom bot name shown in welcome messages (supports Amharic/Unicode)
BOT_NAME=የስነ-ልቦና ድጋፍ ቦት
